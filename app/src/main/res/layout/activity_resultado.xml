<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_geral">

    <Button
        android:id="@+id/button000"
        android:layout_width="278dp"
        android:layout_height="50dp"
        android:layout_marginBottom="148dp"
        android:fontFamily="@font/excalifont_regular"
        android:text="Tentar novamente"
        android:textColor="@color/texto_principal"
        android:textSize="20sp"
        app:backgroundTint="@color/fundo_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/texto_secundario"
        app:strokeWidth="5px" />

    <Button
        android:id="@+id/butto"
        android:layout_width="278dp"
        android:layout_height="50dp"
        android:layout_marginBottom="72dp"
        android:fontFamily="@font/excalifont_regular"
        android:text="Menu"
        android:textColor="@color/fundo_card"
        android:textSize="20sp"
        app:backgroundTint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/texto_secundario"
        app:strokeWidth="5px" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="175dp"
        android:layout_height="202dp"
        app:srcCompat="@drawable/icon_masculino"
        tools:layout_editor_absoluteX="118dp"
        tools:layout_editor_absoluteY="171dp" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pontos:"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="114dp"
        tools:layout_editor_absoluteY="428dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="<Nome jogador>"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="114dp"
        tools:layout_editor_absoluteY="380dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="<pontuaçao>"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="206dp"
        tools:layout_editor_absoluteY="428dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pontuação"
        android:textSize="40sp"
        tools:layout_editor_absoluteX="103dp"
        tools:layout_editor_absoluteY="83dp" />

</androidx.constraintlayout.widget.ConstraintLayout>